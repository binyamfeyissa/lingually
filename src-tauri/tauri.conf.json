{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingually",
  "version": "2.0.0",
  "identifier": "app.lingually.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Lingually — AI Writing Workbench",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "Lingually AI Writing Assistant"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": ["ApplicationServices"],
      "infoPlist": {
        "NSAppleEventsUsageDescription": "Lingually requires accessibility permissions to read and replace text in external applications.",
        "NSSystemAdministrationUsageDescription": "Lingually requires accessibility permissions to detect active writing fields."
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
